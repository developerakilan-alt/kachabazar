# ── API Base URLs ─────────────────────────────────────────────────────────
# Client-side: sent by the browser (use /api to go through nginx reverse proxy)
# Server-side (SSR/ISR): used by Next.js server to fetch data from the backend.
#   In Docker: set to http://kachabazar_backend:5056/v1
#   In local:  set to http://localhost:5056/v1
#   On cPanel: set to your backend public URL or localhost with DNS patch
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_SERVER_API_BASE_URL=http://localhost:5056/v1
NEXT_REWRITE_BACKEND=http://localhost:5056
NEXT_PUBLIC_STORE_URL=http://localhost:3000

NEXT_PUBLIC_CLOUDINARY_URL=https://api.cloudinary.com/v1_1/your_cloud_name/image/upload
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

NEXT_PUBLIC_STRIPE_KEY=pk_live_xxxxxxxxxxxx

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="3BRAQWnfbEfhT3fnlrVMEHe2T7TG9ky4sfs//Xx+8Vc="

# Social Login (Optional) will load from the admin panel settings if not set here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=547396231983-5inn0b2ufh198dsfsdfofn8g23qodoklcatndg.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_SECRET=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
NEXT_PUBLIC_FACEBOOK_ID=
NEXT_PUBLIC_FACEBOOK_SECRET=
