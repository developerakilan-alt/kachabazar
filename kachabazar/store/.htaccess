# Block access to sensitive files
<FilesMatch "^\.env|\.env\.local|server\.js|stderr\.log|package\.json|package-lock\.json">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
  </IfModule>
</FilesMatch>

# Block access to .next directory internals
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\.next/ - [F,L]
  RewriteRule ^node_modules/ - [F,L]
  RewriteRule ^src/ - [F,L]
</IfModule>
