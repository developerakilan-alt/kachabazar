# =====================================================================
# KACHABAZAR BACKEND — ENVIRONMENT VARIABLES
# =====================================================================
#
# Only MANDATORY variables belong here. Everything else (email, SMS,
# Stripe keys, application URLs, etc.) is configured from the Admin
# Dashboard → Settings page and stored encrypted in the database.
#
# After your first login go to: Admin → Settings → scroll down to
#   • Email Configuration (SMTP)
#   • SMS / OTP Configuration
#   • Application URLs
#
# =====================================================================

PORT=5055

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Your MongoDB connection string
# Examples:
#   mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
#   mongodb://localhost:27017/kachabazar
MONGO_URI=mongodb+srv://mdb_user:fsdfsdfsfsfsf@cluster0.hgoxfso.mongodb.net/kachabazar


# Node environment
NODE_ENV=development

# CORS — comma-separated list of allowed origins (leave empty to allow all in dev)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4100


# ===========================================
# JWT CONFIGURATION
# ===========================================
# Generate long random secrets:  openssl rand -hex 64
# JWT Configuration
JWT_SECRET='e8c74caea8379d02a3c093fad6567ae2ad22950e8a698318e465e2e93994de747ac0023acec5b832edd52648abbadc2f9a1b8ac34501510545be9d0f7a22d888'
JWT_ACCESS_LIFETIME=30m
JWT_REFRESH_SECRET='ff47cc8d40b20b99cef1f5d1488dbb6253df9d25c03ca7b070a79002acb75dec127402a7782dcf0291bce80c85bd917b6e38b5594a281322e8d2aef9656c3994'
JWT_REFRESH_LIFETIME=7d

JWT_SECRET_FOR_VERIFY='c74caea8379d02a3c093fad6567ae2ad22950e8a698318e465e2e93994de747ef1f5d1488dbb6253df9d25c03ca7b'


# ===========================================
# ENCRYPTION KEY (REQUIRED)
# ===========================================
# 32-byte hex key — MUST be the same in both admin and backend .env
# This is used to encrypt sensitive settings (email passwords, API keys)
# stored in the database, and for role-based token encryption.
#
# Generate with:  openssl rand -hex 32
ENCRYPT_PASSWORD=856305f1a5b7ba87b8448e69b3bb7a4631c23f0afa2ca5331fa1373f7e372345

# ===========================================
# STRIPE (optional — keep here only for amount limits)
# ===========================================
# Stripe secret key and payment config are managed in Admin → Store
# Settings. Only these validation limits need to stay in .env:
MAX_AMOUNT=10000.0
MIN_AMOUNT=10.0
AMOUNT_STEP=5.0
CURRENCY=usd
STRIPE_PAYMENT_DESCRIPTION="This is Kachabazar payment with Stripe!"

# ===========================================
# NOTE: The following are NO LONGER needed in .env
# They are now managed from the Admin Dashboard with encryption:
#
#   EMAIL_USER, EMAIL_PASS, HOST, EMAIL_PORT, SERVICE
#   SMS_PROVIDER, TWILIO_*, MESSAGEBIRD_*, VONAGE_*, AWS_*
#   STORE_URL, ADMIN_URL, APP_NAME, SMS_SENDER_ID
#
# If these variables exist in your .env they will be used as FALLBACK
# values only (DB settings take priority). You can safely remove them.
# =====================================================================


